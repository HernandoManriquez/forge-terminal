{
  "version": 1,
  "checks": [
    {
      "name": "Go unit and PTY integration (race detector)",
      "command": [
        "go",
        "test",
        "-race",
        "-count=1",
        "-coverprofile=reports/coverage.out",
        "-coverpkg=./src/internal/...",
        "./src/internal/..."
      ]
    },
    {
      "name": "Go static checks",
      "command": [
        "go",
        "vet",
        "./src/internal/..."
      ]
    },
    {
      "name": "UI models, shortcuts, cURL, inspector, data and snippet invariants",
      "command": [
        "node",
        "scripts/test-models.mjs"
      ]
    },
    {
      "name": "UI production bundle",
      "command": [
        "node",
        "scripts/build-ui.mjs"
      ]
    },
    {
      "name": "Headless executable",
      "command": [
        "go",
        "build",
        "-buildvcs=false",
        "-tags",
        "headless",
        "-o",
        "build/forge-headless",
        "./src/cmd/forge"
      ]
    },
    {
      "name": "End-to-end UI and real PTY",
      "command": [
        "node",
        "tests/e2e.mjs"
      ],
      "platforms": [
        "linux"
      ]
    },
    {
      "name": "Editor files and independent window",
      "command": [
        "node",
        "tests/editor-e2e.mjs"
      ],
      "platforms": [
        "linux"
      ]
    },
    {
      "name": "Complete terminal rows and scroll following",
      "command": [
        "node",
        "tests/scroll-e2e.mjs"
      ],
      "platforms": [
        "linux"
      ]
    },
    {
      "name": "Shared actions, palette and shortcut persistence",
      "command": [
        "node",
        "tests/actions-e2e.mjs"
      ],
      "platforms": [
        "linux"
      ]
    },
    {
      "name": "Real HTTP requests, cURL, history and cancellation",
      "command": [
        "node",
        "tests/api-e2e.mjs"
      ],
      "platforms": [
        "linux"
      ]
    },
    {
      "name": "Real ports, processes and confirmed termination",
      "command": [
        "node",
        "tests/inspector-e2e.mjs"
      ],
      "platforms": [
        "linux"
      ]
    },
    {
      "name": "JSON, YAML, XML and file operations",
      "command": [
        "node",
        "tests/data-e2e.mjs"
      ],
      "platforms": [
        "linux"
      ]
    },
    {
      "name": "Parameterized snippets, persistence and explicit execution",
      "command": [
        "node",
        "tests/snippets-e2e.mjs"
      ],
      "platforms": [
        "linux"
      ]
    }
  ]
}
